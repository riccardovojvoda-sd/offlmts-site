---
layout: layouts/base.njk
og_type: article
---
<article class="post">
  <header class="intestazione">
    <div class="contenitore">
      {%- if lingua == "en" %}
      <p class="occhiello"><a href="/en/tips/">Tips</a> · <time datetime="{{ page.date | dataIso }}">{{ page.date | dataEn }}</time>{% if aggiornato %} · updated <time datetime="{{ aggiornato | dataIso }}">{{ aggiornato | dataEn }}</time>{% endif %}</p>
      {%- else %}
      <p class="occhiello"><a href="/dritte/">Dritte</a> · <time datetime="{{ page.date | dataIso }}">{{ page.date | dataIt }}</time>{% if aggiornato %} · aggiornato il <time datetime="{{ aggiornato | dataIso }}">{{ aggiornato | dataIt }}</time>{% endif %}</p>
      {%- endif %}
      <h1>{{ titolo }}</h1>
      {%- if coppia %}<p class="post-lingua"><a href="{{ coppia }}" hreflang="{{ "it" if lingua == "en" else "en" }}">{{ "Versione italiana" if lingua == "en" else "English version" }}</a></p>{% endif %}
    </div>
  </header>
  <div class="contenitore post-corpo">
    {{ content | safe }}
  </div>
  {%- if tags.length > 1 %}
  <div class="contenitore post-tag">
    <p class="occhiello">{{ "Topics" if lingua == "en" else "Argomenti" }}</p>
    <ul class="etichette">
      {%- for t in tags %}{% if t != "dritte" and t != "tips" %}<li>{{ t }}</li>{% endif %}{% endfor %}
    </ul>
  </div>
  {%- endif %}
  <div class="contenitore post-fine">
    {%- if lingua == "en" %}<a class="bottone vuoto" href="/en/tips/">All tips</a>{% else %}<a class="bottone vuoto" href="/dritte/">Tutte le Dritte</a>{% endif %}
  </div>
</article>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": titolo,
  "description": descrizione,
  "datePublished": page.date | dataIso,
  "dateModified": (aggiornato | dataIso) if aggiornato else (page.date | dataIso),
  "inLanguage": lingua or "it",
  "image": (sito.url + "/assets/img/dritte/" + copertina) if copertina else undefined,
  "author": { "@type": "Person", "name": sito.titolare, "alternateName": sito.alias },
  "publisher": { "@type": "Organization", "name": sito.nome, "logo": { "@type": "ImageObject", "url": sito.url + "/icon-512.png" } },
  "mainEntityOfPage": sito.url + page.url
} | json | safe }}</script>
