<header class="testata">
  <a class="marchio" href="/" aria-label="{{ sito.nome }}, home">
    <img class="marchio-logo" src="/assets/img/logo-offlmts.png" alt="OFFLMTS Recording Studio" width="803" height="369" decoding="async">
  </a>
  <nav class="menu" aria-label="Menu principale">
    <a class="menu-home" href="/" aria-label="Home"><img src="/icon-192.png" alt="" width="192" height="192" decoding="async"></a>
    <a href="/servizi/"{% if page.url == "/servizi/" %} aria-current="page"{% endif %}>Servizi</a>
    <a href="/prepara-il-materiale/"{% if page.url == "/prepara-il-materiale/" %} aria-current="page"{% endif %}>Materiale</a>
    <a href="/dritte/"{% if (page.url or "").startsWith("/dritte/") %} aria-current="page"{% endif %}>Dritte</a>
    <a href="/chi-sono/"{% if page.url == "/chi-sono/" %} aria-current="page"{% endif %}>Chi sono</a>
    <a class="menu-cta" href="/contatti/"{% if page.url == "/contatti/" %} aria-current="page"{% endif %}>Scrivimi</a>
  </nav>
</header>
